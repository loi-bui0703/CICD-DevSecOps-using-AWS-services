// DevSecOps pipeline for the repository that contains this Jenkinsfile.
// Cloud and GitOps integrations are opt-in so local development remains usable
// while the AWS and security contracts are being completed by other members.

def runSecurityScript(Map config) {
  String scriptPath = config.script as String
  String displayName = config.name as String
  String scanMode = (config.mode ?: params.SECURITY_MODE ?: 'stub') as String
  List<String> expectedReports = (config.expectedReports ?: []) as List<String>
  List<String> scanEnvironment = (config.environment ?: []) as List<String>
  scanEnvironment += [
    "SECURITY_MODE=${scanMode}",
    "SECURITY_BLOCK_SEVERITIES=${params.SECURITY_BLOCK_SEVERITIES}"
  ]

  if (scanMode == 'stub') {
    echo "[STUB] ${displayName} is disabled by SECURITY_MODE=stub."
    return
  }

  boolean scriptReady = fileExists(scriptPath) &&
    sh(script: "test -s '${scriptPath}'", returnStatus: true) == 0

  if (!scriptReady) {
    String message = "${displayName} integration is not ready: ${scriptPath} is missing or empty."
    if (scanMode == 'enforce') {
      error(message)
    }
    unstable(message)
    return
  }

  Closure executeScan = {
    withEnv(scanEnvironment) {
      sh(
        label: displayName,
        script: """#!/usr/bin/env bash
set -euo pipefail
chmod +x '${scriptPath}'
'${scriptPath}'
"""
      )
    }
  }

  if (scanMode == 'enforce') {
    executeScan()
  } else {
    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
      executeScan()
    }
  }

  List<String> missingReports = expectedReports.findAll { !fileExists(it) }
  if (!missingReports.isEmpty()) {
    String message = "${displayName} did not create expected report(s): ${missingReports.join(', ')}"
    if (scanMode == 'enforce') {
      error(message)
    }
    unstable(message)
  }
}

def withAwsAuth(Closure body) {
  List<String> regionEnvironment = [
    "AWS_REGION=${params.AWS_REGION}",
    "AWS_DEFAULT_REGION=${params.AWS_REGION}"
  ]

  if (params.AWS_AUTH_MODE == 'jenkins-credentials') {
    withCredentials([
      usernamePassword(
        credentialsId: params.AWS_CREDENTIALS_ID,
        usernameVariable: 'AWS_ACCESS_KEY_ID',
        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
      )
    ]) {
      withEnv(regionEnvironment) {
        body()
      }
    }
  } else {
    withEnv(regionEnvironment) {
      body()
    }
  }
}

def updateGitOpsOverlay(String targetEnvironment) {
  String checkoutDirectory = "gitops-${targetEnvironment}"

  dir(checkoutDirectory) {
    deleteDir()
    checkout([
      $class: 'GitSCM',
      branches: [[name: "*/${params.GITOPS_BRANCH}"]],
      extensions: [
        [$class: 'LocalBranch', localBranch: params.GITOPS_BRANCH],
        [$class: 'CloneOption', depth: 0, noTags: false, shallow: false]
      ],
      userRemoteConfigs: [[
        credentialsId: params.GIT_CREDENTIALS_ID,
        url: params.GITOPS_REPO_URL
      ]]
    ])

    withEnv([
      "GITOPS_ENVIRONMENT=${targetEnvironment}",
      "GITOPS_BRANCH=${params.GITOPS_BRANCH}"
    ]) {
      sh '''#!/usr/bin/env bash
set -euo pipefail

OVERLAY_DIR="kubernetes/overlays/${GITOPS_ENVIRONMENT}"
test -f "${OVERLAY_DIR}/kustomization.yaml"

cd "${OVERLAY_DIR}"
kustomize edit set image "tetris-devsecops=${IMAGE_URI}"
cd ../../..

git config user.email "jenkins@localhost"
git config user.name "Jenkins CI"
git add "${OVERLAY_DIR}/kustomization.yaml"
'''

      if (sh(script: 'git diff --cached --quiet', returnStatus: true) == 0) {
        echo "GitOps ${targetEnvironment} already points to ${env.IMAGE_URI}; no commit required."
        return
      }

      sh '''#!/usr/bin/env bash
set -euo pipefail
git commit -m "chore(gitops): promote ${GITOPS_ENVIRONMENT} to ${IMAGE_TAG} [skip ci]"
'''

      withCredentials([
        usernamePassword(
          credentialsId: params.GIT_CREDENTIALS_ID,
          usernameVariable: 'GIT_USERNAME',
          passwordVariable: 'GIT_TOKEN'
        )
      ]) {
        sh '''#!/usr/bin/env bash
set +x
set -euo pipefail

# The temporary credential helper reads masked environment variables. It does
# not write the token into the remote URL or the repository configuration.
git -c credential.helper='!f() { echo "username=${GIT_USERNAME}"; echo "password=${GIT_TOKEN}"; }; f' \
  push origin "HEAD:${GITOPS_BRANCH}"
'''
      }
    }
  }
}

def deployEcsService(String serviceName, String taskFamily, String desiredCount) {
  withEnv([
    "ECS_SERVICE_NAME=${serviceName}",
    "ECS_TASK_FAMILY=${taskFamily}",
    "ECS_DESIRED_COUNT=${desiredCount}"
  ]) {
    sh '''#!/usr/bin/env bash
set -euo pipefail

REPORT_DIR="${SCAN_REPORT_DIR}/ecs-${ECS_SERVICE_NAME}"
mkdir -p "${REPORT_DIR}"

aws ecs describe-task-definition \
  --task-definition "${ECS_TASK_FAMILY}" \
  --output json > "${REPORT_DIR}/current-task-definition.json"

jq --arg container "${ECS_CONTAINER_NAME}" --arg image "${IMAGE_URI}" '
  .taskDefinition as $task
  | if any($task.containerDefinitions[]; .name == $container) then
      $task
      | .containerDefinitions |= map(
          if .name == $container then .image = $image else . end
        )
      | del(
          .taskDefinitionArn,
          .revision,
          .status,
          .requiresAttributes,
          .compatibilities,
          .registeredAt,
          .registeredBy,
          .deregisteredAt
        )
    else
      error("Container name not found in ECS task definition: " + $container)
    end
' "${REPORT_DIR}/current-task-definition.json" \
  > "${REPORT_DIR}/next-task-definition.json"

TASK_DEFINITION_ARN="$(aws ecs register-task-definition \
  --cli-input-json "file://${REPORT_DIR}/next-task-definition.json" \
  --query 'taskDefinition.taskDefinitionArn' \
  --output text)"

aws ecs update-service \
  --cluster "${ECS_CLUSTER}" \
  --service "${ECS_SERVICE_NAME}" \
  --task-definition "${TASK_DEFINITION_ARN}" \
  --desired-count "${ECS_DESIRED_COUNT}" \
  --force-new-deployment \
  --output json > "${REPORT_DIR}/update-service.json"

aws ecs wait services-stable \
  --cluster "${ECS_CLUSTER}" \
  --services "${ECS_SERVICE_NAME}"

printf '%s\n' "${TASK_DEFINITION_ARN}" > "${REPORT_DIR}/task-definition-arn.txt"
echo "ECS service ${ECS_SERVICE_NAME} is stable on ${IMAGE_URI}."
'''
  }
}

pipeline {
  agent any

  parameters {
    choice(
      name: 'DEMO_PRESET',
      choices: ['CUSTOM', 'FULL_AWS_DEMO'],
      description: 'FULL_AWS_DEMO is populated automatically by scripts/demo-trigger.sh.'
    )
    choice(
      name: 'REGISTRY_TARGET',
      choices: ['local', 'ecr'],
      description: 'Push to the local registry or Amazon ECR.'
    )
    string(
      name: 'LOCAL_REGISTRY',
      defaultValue: 'local-registry:5000',
      description: 'Local Docker registry host:port.'
    )
    string(
      name: 'ECR_REGISTRY',
      defaultValue: '',
      description: 'ECR registry host, for example 123456789012.dkr.ecr.ap-southeast-1.amazonaws.com.'
    )
    string(
      name: 'IMAGE_REPOSITORY',
      defaultValue: 'devsecops/tetris',
      description: 'Repository path inside the selected registry.'
    )
    string(
      name: 'IMAGE_PLATFORM',
      defaultValue: 'linux/amd64',
      description: 'Target image platform. ECS Fargate uses linux/amd64 by default.'
    )
    string(name: 'AWS_REGION', defaultValue: 'ap-southeast-1', description: 'AWS region.')
    choice(
      name: 'AWS_AUTH_MODE',
      choices: ['default-chain', 'jenkins-credentials'],
      description: 'Use an IAM role/environment provider chain or a Jenkins username/password credential.'
    )
    string(
      name: 'AWS_CREDENTIALS_ID',
      defaultValue: 'aws-credentials',
      description: 'Jenkins credential ID: username is access key ID, password is secret access key.'
    )

    choice(
      name: 'SECURITY_MODE',
      choices: ['stub', 'report-only', 'enforce'],
      description: 'stub skips scanners; report-only continues as UNSTABLE; enforce blocks on scanner/report failure.'
    )
    string(
      name: 'SECURITY_BLOCK_SEVERITIES',
      defaultValue: 'CRITICAL',
      description: 'Comma-separated Trivy severities that block enforce mode.'
    )
    booleanParam(name: 'ENABLE_SAST', defaultValue: false, description: 'Run SonarQube SAST when its service and token are ready.')
    string(name: 'SONAR_HOST_URL', defaultValue: 'http://sonarqube:9000', description: 'SonarQube URL visible from Jenkins.')
    booleanParam(name: 'ENABLE_DAST', defaultValue: false, description: 'Run DAST after staging deployment.')
    choice(
      name: 'DAST_GATE_MODE',
      choices: ['report-only', 'enforce'],
      description: 'Control ZAP independently from the main security mode so production can remain enforce while DAST reports non-blocking alerts.'
    )
    string(name: 'STAGING_URL', defaultValue: '', description: 'URL consumed by the DAST script, including scheme.')
    booleanParam(name: 'ENABLE_S3_UPLOAD', defaultValue: false, description: 'Upload available security reports to S3.')
    string(name: 'SECURITY_REPORT_BUCKET', defaultValue: '', description: 'S3 bucket name supplied by Task 1.')
    booleanParam(
      name: 'ENABLE_SECURITY_HUB_IMPORT',
      defaultValue: false,
      description: 'Generate ASFF and upload it to the S3 prefix watched by the Lambda Security Hub importer.'
    )

    booleanParam(name: 'ENABLE_GITOPS_UPDATE', defaultValue: false, description: 'Commit the immutable image tag to staging/production overlays.')
    string(
      name: 'GITOPS_REPO_URL',
      defaultValue: 'https://github.com/loi-bui0703/FCAJ-final-project.git',
      description: 'Repository containing kubernetes/overlays.'
    )
    string(name: 'GITOPS_BRANCH', defaultValue: 'main', description: 'Branch watched by Argo CD.')
    string(name: 'GIT_CREDENTIALS_ID', defaultValue: 'github-token', description: 'Jenkins username/password credential used to push GitOps commits.')
    string(name: 'RELEASE_BRANCH', defaultValue: 'main', description: 'Only this source branch can update staging or production.')

    booleanParam(name: 'ENABLE_ECS_DEPLOY', defaultValue: false, description: 'Register a task definition revision and update ECS services.')
    string(name: 'ECS_CLUSTER', defaultValue: 'devsecops-factory-cluster', description: 'ECS cluster name from Terraform.')
    string(name: 'ECS_STAGING_SERVICE', defaultValue: 'tetris-staging', description: 'ECS staging service name.')
    string(name: 'ECS_STAGING_TASK_FAMILY', defaultValue: 'tetris-app', description: 'Current ECS staging task definition family.')
    string(name: 'ECS_STAGING_DESIRED_COUNT', defaultValue: '1', description: 'Number of staging tasks to run after deployment.')
    string(name: 'ECS_PRODUCTION_SERVICE', defaultValue: 'tetris-production', description: 'ECS production service name.')
    string(name: 'ECS_PRODUCTION_TASK_FAMILY', defaultValue: 'tetris-app', description: 'Current ECS production task definition family.')
    string(name: 'ECS_PRODUCTION_DESIRED_COUNT', defaultValue: '2', description: 'Number of production tasks to run after approval.')
    string(name: 'ECS_CONTAINER_NAME', defaultValue: 'tetris', description: 'Container name to replace in ECS task definitions.')

    booleanParam(name: 'PROMOTE_PRODUCTION', defaultValue: false, description: 'Show a manual gate and promote the same immutable image to production.')
    string(name: 'PRODUCTION_APPROVERS', defaultValue: '', description: 'Optional comma-separated Jenkins user IDs allowed to approve.')
    string(name: 'APPROVAL_TIMEOUT_MINUTES', defaultValue: '30', description: 'How long Jenkins waits for production approval.')
  }

  environment {
    TARGET_DIR = "${WORKSPACE}"
    SCAN_REPORT_DIR = "${WORKSPACE}/scan-reports"
  }

  options {
    skipDefaultCheckout(true)
    timeout(time: 2, unit: 'HOURS')
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  stages {
    stage('1. Checkout Monorepo') {
      steps {
        deleteDir()
        script {
          Map scmVars = checkout(scm) as Map
          String commitSha = (scmVars.GIT_COMMIT ?: sh(
            script: 'git rev-parse HEAD',
            returnStdout: true
          )).trim()
          String branchName = (
            env.CHANGE_BRANCH ?: env.BRANCH_NAME ?: scmVars.GIT_BRANCH ?: 'unknown'
          ).replaceFirst(/^origin\//, '')
          String commitMessage = sh(
            script: 'git log -1 --pretty=%B',
            returnStdout: true
          ).trim()

          env.GIT_COMMIT_SHA = commitSha
          env.GIT_COMMIT_SHORT = commitSha.take(12)
          env.SOURCE_BRANCH = branchName
          env.SKIP_PIPELINE = commitMessage.contains('[skip ci]') ? 'true' : 'false'

          echo "Source branch: ${env.SOURCE_BRANCH}"
          echo "Source commit: ${env.GIT_COMMIT_SHA}"
          if (env.SKIP_PIPELINE == 'true') {
            echo 'The commit contains [skip ci]; deployment stages will be skipped.'
          }
        }
      }
    }

    stage('CI/CD') {
      when {
        expression { env.SKIP_PIPELINE != 'true' }
      }

      stages {
        stage('2. Validate Inputs and Metadata') {
          steps {
            script {
              String registry = params.REGISTRY_TARGET == 'ecr' ?
                params.ECR_REGISTRY.trim() : params.LOCAL_REGISTRY.trim()
              String repository = params.IMAGE_REPOSITORY.trim().replaceAll('^/+|/+$', '')
              String imagePlatform = (params.IMAGE_PLATFORM ?: 'linux/amd64').trim()
              String releaseBranch = params.RELEASE_BRANCH.trim()
              String demoPreset = (params.DEMO_PRESET ?: 'CUSTOM').trim()
              String dastGateMode = (params.DAST_GATE_MODE ?: 'report-only').trim()

              if (demoPreset == 'FULL_AWS_DEMO') {
                List<String> presetErrors = []
                if (params.REGISTRY_TARGET != 'ecr') {
                  presetErrors.add('REGISTRY_TARGET=ecr')
                }
                if (imagePlatform != 'linux/amd64') {
                  presetErrors.add('IMAGE_PLATFORM=linux/amd64')
                }
                if (params.AWS_AUTH_MODE != 'jenkins-credentials') {
                  presetErrors.add('AWS_AUTH_MODE=jenkins-credentials')
                }
                if (params.SECURITY_MODE != 'enforce') {
                  presetErrors.add('SECURITY_MODE=enforce')
                }
                if (!params.ENABLE_DAST || dastGateMode != 'report-only') {
                  presetErrors.add('ENABLE_DAST=true and DAST_GATE_MODE=report-only')
                }
                if (!params.ENABLE_S3_UPLOAD) {
                  presetErrors.add('ENABLE_S3_UPLOAD=true')
                }
                if (!params.ENABLE_ECS_DEPLOY) {
                  presetErrors.add('ENABLE_ECS_DEPLOY=true')
                }
                if (!params.PROMOTE_PRODUCTION) {
                  presetErrors.add('PROMOTE_PRODUCTION=true')
                }
                if (params.ECS_PRODUCTION_DESIRED_COUNT != '1') {
                  presetErrors.add('ECS_PRODUCTION_DESIRED_COUNT=1')
                }
                if (params.ENABLE_GITOPS_UPDATE ||
                  params.ENABLE_SECURITY_HUB_IMPORT ||
                  params.ENABLE_SAST) {
                  presetErrors.add('GitOps, Security Hub import, and SAST disabled')
                }
                if (!presetErrors.isEmpty()) {
                  error("FULL_AWS_DEMO preset mismatch: ${presetErrors.join('; ')}. Use scripts/demo-trigger.sh.")
                }
              }

              if (!registry) {
                error("${params.REGISTRY_TARGET == 'ecr' ? 'ECR_REGISTRY' : 'LOCAL_REGISTRY'} is required.")
              }
              if (registry.contains('://') || registry.endsWith('/')) {
                error('Registry must be a host name without scheme or trailing slash.')
              }
              if (!repository) {
                error('IMAGE_REPOSITORY is required.')
              }
              if (!(imagePlatform ==~ /^linux\/(amd64|arm64)$/)) {
                error('IMAGE_PLATFORM must be linux/amd64 or linux/arm64.')
              }
              if (!releaseBranch) {
                error('RELEASE_BRANCH is required.')
              }
              if (!(dastGateMode in ['report-only', 'enforce'])) {
                error('DAST_GATE_MODE must be report-only or enforce.')
              }
              if (params.ENABLE_DAST && !params.STAGING_URL.trim()) {
                error('STAGING_URL is required when ENABLE_DAST=true.')
              }
              if (params.ENABLE_S3_UPLOAD && !params.SECURITY_REPORT_BUCKET.trim()) {
                error('SECURITY_REPORT_BUCKET is required when ENABLE_S3_UPLOAD=true.')
              }
              if (params.ENABLE_SECURITY_HUB_IMPORT && !params.ENABLE_S3_UPLOAD) {
                error('ENABLE_SECURITY_HUB_IMPORT requires ENABLE_S3_UPLOAD=true.')
              }
              if (params.ENABLE_SECURITY_HUB_IMPORT && params.SECURITY_MODE == 'stub') {
                error('ENABLE_SECURITY_HUB_IMPORT requires real security scans.')
              }
              if (!(params.SECURITY_BLOCK_SEVERITIES ==~ /^(CRITICAL|HIGH|MEDIUM|LOW)(,(CRITICAL|HIGH|MEDIUM|LOW))*$/)) {
                error('SECURITY_BLOCK_SEVERITIES must be a comma-separated severity list.')
              }
              if (params.ENABLE_GITOPS_UPDATE && (
                !params.GITOPS_REPO_URL.trim() ||
                !params.GITOPS_BRANCH.trim() ||
                !params.GIT_CREDENTIALS_ID.trim()
              )) {
                error('GitOps repo URL, branch, and credential ID are required.')
              }
              if (params.ENABLE_ECS_DEPLOY && params.REGISTRY_TARGET != 'ecr') {
                error('ENABLE_ECS_DEPLOY requires REGISTRY_TARGET=ecr.')
              }
              if (params.ENABLE_ECS_DEPLOY && (
                !params.ECS_CLUSTER.trim() ||
                !params.ECS_STAGING_SERVICE.trim() ||
                !params.ECS_STAGING_TASK_FAMILY.trim() ||
                !params.ECS_CONTAINER_NAME.trim()
              )) {
                error('ECS cluster, staging service, task family, and container name are required.')
              }
              [
                staging: params.ECS_STAGING_DESIRED_COUNT,
                production: params.ECS_PRODUCTION_DESIRED_COUNT
              ].each { String environmentName, String desiredCount ->
                if (!(desiredCount ==~ /^\d+$/)) {
                  error("ECS ${environmentName} desired count must be a non-negative integer.")
                }
              }
              if (params.PROMOTE_PRODUCTION &&
                !params.ENABLE_GITOPS_UPDATE &&
                !params.ENABLE_ECS_DEPLOY) {
                error('Production promotion requires GitOps, ECS deployment, or both.')
              }
              if (params.PROMOTE_PRODUCTION && params.SECURITY_MODE != 'enforce') {
                error('Production promotion requires SECURITY_MODE=enforce.')
              }
              if (params.PROMOTE_PRODUCTION && params.ENABLE_ECS_DEPLOY && (
                !params.ECS_PRODUCTION_SERVICE.trim() ||
                !params.ECS_PRODUCTION_TASK_FAMILY.trim()
              )) {
                error('ECS production service and task family are required for promotion.')
              }

              int approvalTimeout
              try {
                approvalTimeout = params.APPROVAL_TIMEOUT_MINUTES.toInteger()
              } catch (NumberFormatException ignored) {
                error('APPROVAL_TIMEOUT_MINUTES must be an integer.')
              }
              if (approvalTimeout < 1 || approvalTimeout > 1440) {
                error('APPROVAL_TIMEOUT_MINUTES must be between 1 and 1440.')
              }

              env.REGISTRY = registry
              env.REPO_NAME = repository
              env.IMAGE_PLATFORM = imagePlatform
              env.IMAGE_NAME = "${registry}/${repository}"
              env.IMAGE_TAG = env.GIT_COMMIT_SHORT
              env.IMAGE_URI = "${env.IMAGE_NAME}:${env.IMAGE_TAG}"
              env.LATEST_IMAGE_URI = "${env.IMAGE_NAME}:latest"
              env.IS_RELEASE_BRANCH = (env.SOURCE_BRANCH == releaseBranch).toString()
              env.APPROVAL_TIMEOUT = approvalTimeout.toString()
              env.DEMO_PRESET_EFFECTIVE = demoPreset
              env.DAST_GATE_MODE_EFFECTIVE = dastGateMode

              sh '''#!/usr/bin/env bash
set -euo pipefail
mkdir -p "${SCAN_REPORT_DIR}"
test -f app/Dockerfile
test -f app/package.json
'''

              writeFile(
                file: 'scan-reports/pipeline-metadata.txt',
                text: """source_branch=${env.SOURCE_BRANCH}
source_commit=${env.GIT_COMMIT_SHA}
image_uri=${env.IMAGE_URI}
image_platform=${env.IMAGE_PLATFORM}
registry_target=${params.REGISTRY_TARGET}
security_mode=${params.SECURITY_MODE}
dast_gate_mode=${env.DAST_GATE_MODE_EFFECTIVE}
demo_preset=${env.DEMO_PRESET_EFFECTIVE}
release_branch=${releaseBranch}
"""
              )

              currentBuild.description = "${env.SOURCE_BRANCH} -> ${env.IMAGE_TAG}"
              echo "Immutable image: ${env.IMAGE_URI}"
              echo "Release branch: ${env.IS_RELEASE_BRANCH}"
            }
          }
        }

        stage('3. Security Contract') {
          steps {
            script {
              List<String> scripts = [
                'ci/stages/secrets-scan.sh',
                'ci/stages/sca-scan.sh',
                'ci/stages/sast-scan.sh',
                'ci/stages/iac-scan.sh',
                'ci/stages/container-scan.sh',
                'ci/stages/dast-scan.sh'
              ]
              List<String> statusLines = scripts.collect { String path ->
                boolean ready = fileExists(path) &&
                  sh(script: "test -s '${path}'", returnStatus: true) == 0
                return "${path}=${ready ? 'ready' : 'missing-or-empty'}"
              }
              statusLines.add(0, "security_mode=${params.SECURITY_MODE}")
              statusLines.add(1, "dast_gate_mode=${env.DAST_GATE_MODE_EFFECTIVE}")
              statusLines.add(2, "demo_preset=${env.DEMO_PRESET_EFFECTIVE}")
              writeFile(
                file: 'scan-reports/security-integration-status.txt',
                text: statusLines.join('\n') + '\n'
              )
              echo statusLines.join('\n')
            }
          }
        }

        stage('4. Secrets Scan') {
          when { expression { params.SECURITY_MODE != 'stub' } }
          steps {
            script {
              runSecurityScript([
                name: 'Secrets scan',
                script: 'ci/stages/secrets-scan.sh',
                expectedReports: ['scan-reports/gitleaks-report.json'],
                environment: [
                  "SCAN_DIR=${env.TARGET_DIR}",
                  "SCAN_REPORT_DIR=${env.SCAN_REPORT_DIR}"
                ]
              ])
            }
          }
        }

        stage('5. SCA Scan') {
          when { expression { params.SECURITY_MODE != 'stub' } }
          steps {
            script {
              runSecurityScript([
                name: 'SCA scan',
                script: 'ci/stages/sca-scan.sh',
                expectedReports: ['scan-reports/trivy-sca-report.json'],
                environment: [
                  "SCAN_DIR=${env.TARGET_DIR}",
                  "SCAN_REPORT_DIR=${env.SCAN_REPORT_DIR}"
                ]
              ])
            }
          }
        }

        stage('6. SAST Scan') {
          when {
            allOf {
              expression { params.SECURITY_MODE != 'stub' }
              expression { params.ENABLE_SAST }
            }
          }
          steps {
            withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
              script {
                runSecurityScript([
                  name: 'SAST scan',
                  script: 'ci/stages/sast-scan.sh',
                  expectedReports: ['scan-reports/sonar-issues.json'],
                  environment: [
                    "SCAN_DIR=${env.TARGET_DIR}",
                    "SONAR_HOST=${params.SONAR_HOST_URL}",
                    "IMAGE_TAG=${env.IMAGE_TAG}"
                  ]
                ])
              }
            }
          }
        }

        stage('7. IaC Scan') {
          when { expression { params.SECURITY_MODE != 'stub' } }
          steps {
            script {
              runSecurityScript([
                name: 'IaC scan',
                script: 'ci/stages/iac-scan.sh',
                expectedReports: ['scan-reports/checkov_report.json'],
                environment: [
                  "SCAN_DIR=${env.TARGET_DIR}",
                  "SCAN_REPORT_DIR=${env.SCAN_REPORT_DIR}"
                ]
              ])
            }
          }
        }

        stage('8. Build Docker Image') {
          steps {
            sh '''#!/usr/bin/env bash
set -euo pipefail
docker build \
  --platform "${IMAGE_PLATFORM}" \
  --label "org.opencontainers.image.revision=${GIT_COMMIT_SHA}" \
  --label "org.opencontainers.image.source=${GIT_URL:-local}" \
  -t "${IMAGE_URI}" \
  -t "${LATEST_IMAGE_URI}" \
  -f app/Dockerfile \
  app
docker image inspect "${IMAGE_URI}" >/dev/null
'''
          }
        }

        stage('9. Container Scan') {
          when { expression { params.SECURITY_MODE != 'stub' } }
          steps {
            script {
              runSecurityScript([
                name: 'Container scan',
                script: 'ci/stages/container-scan.sh',
                expectedReports: ['scan-reports/container-scan-report.json'],
                environment: [
                  "IMAGE_FULL_PATH=${env.IMAGE_URI}",
                  "SCAN_REPORT_DIR=${env.SCAN_REPORT_DIR}"
                ]
              ])
            }
          }
        }

        stage('10. Amazon ECR Login') {
          when { expression { params.REGISTRY_TARGET == 'ecr' } }
          steps {
            script {
              withAwsAuth {
                sh '''#!/usr/bin/env bash
set +x
set -euo pipefail
aws sts get-caller-identity --output json > "${SCAN_REPORT_DIR}/aws-caller-identity.json"
aws ecr get-login-password --region "${AWS_REGION}" \
  | docker login --username AWS --password-stdin "${REGISTRY}"
'''
              }
            }
          }
        }

        stage('11. Push Image') {
          steps {
            sh '''#!/usr/bin/env bash
set -euo pipefail
docker push "${IMAGE_URI}"

if [ "${IS_RELEASE_BRANCH}" = "true" ]; then
  docker push "${LATEST_IMAGE_URI}"
else
  echo "Not on ${RELEASE_BRANCH:-release branch}; latest tag was not pushed."
fi
'''
          }
        }

        stage('12. Update GitOps Staging') {
          when {
            allOf {
              expression { params.ENABLE_GITOPS_UPDATE }
              expression { env.IS_RELEASE_BRANCH == 'true' }
            }
          }
          steps {
            script {
              updateGitOpsOverlay('staging')
            }
          }
        }

        stage('13. Deploy ECS Staging') {
          when {
            allOf {
              expression { params.ENABLE_ECS_DEPLOY }
              expression { env.IS_RELEASE_BRANCH == 'true' }
            }
          }
          steps {
            script {
              withAwsAuth {
                deployEcsService(
                  params.ECS_STAGING_SERVICE,
                  params.ECS_STAGING_TASK_FAMILY,
                  params.ECS_STAGING_DESIRED_COUNT
                )
              }
            }
          }
        }

        stage('14. DAST Staging') {
          when {
            allOf {
              expression { params.SECURITY_MODE != 'stub' }
              expression { params.ENABLE_DAST }
              expression { env.IS_RELEASE_BRANCH == 'true' }
            }
          }
          steps {
            script {
              runSecurityScript([
                name: 'DAST scan',
                script: 'ci/stages/dast-scan.sh',
                mode: params.SECURITY_MODE == 'enforce' ?
                  'enforce' : env.DAST_GATE_MODE_EFFECTIVE,
                expectedReports: [
                  'scan-reports/zap-report.html',
                  'scan-reports/zap-report.xml',
                  'scan-reports/zap-report.json'
                ],
                environment: [
                  "TARGET_URL=${params.STAGING_URL}",
                  "REPORT_DIR=${env.SCAN_REPORT_DIR}/raw/dast",
                  "SCAN_REPORT_DIR=${env.SCAN_REPORT_DIR}",
                  "DAST_FAIL_ON_ALERT=${env.DAST_GATE_MODE_EFFECTIVE == 'enforce'}"
                ]
              ])
            }
          }
        }

        stage('15. Normalize Security Reports') {
          when { expression { params.SECURITY_MODE != 'stub' } }
          steps {
            sh '''#!/usr/bin/env bash
set -euo pipefail
mkdir -p "${SCAN_REPORT_DIR}/normalized"
python3 ci/stages/normalize-reports.py \
  --raw-dir "${SCAN_REPORT_DIR}/raw" \
  --out "${SCAN_REPORT_DIR}/normalized/findings.json" \
  --summary "${SCAN_REPORT_DIR}/normalized/summary.json" \
  --app tetris \
  --env staging \
  --commit "${GIT_COMMIT_SHA}" \
  --build "${BUILD_NUMBER}"
'''
          }
        }

        stage('16. Generate Security Hub ASFF') {
          when { expression { params.ENABLE_SECURITY_HUB_IMPORT } }
          steps {
            script {
              withAwsAuth {
                sh '''#!/usr/bin/env bash
set -euo pipefail
mkdir -p "${SCAN_REPORT_DIR}/asff"
AWS_ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"
python3 ci/stages/generate-asff.py \
  --input "${SCAN_REPORT_DIR}/normalized/findings.json" \
  --out "${SCAN_REPORT_DIR}/asff/securityhub-asff.json" \
  --region "${AWS_REGION}" \
  --account-id "${AWS_ACCOUNT_ID}"
'''
              }
            }
          }
        }

        stage('17. Upload Security Reports to S3') {
          when { expression { params.ENABLE_S3_UPLOAD } }
          steps {
            script {
              withAwsAuth {
                withEnv(["SECURITY_REPORT_BUCKET=${params.SECURITY_REPORT_BUCKET}"]) {
                  sh '''#!/usr/bin/env bash
set -euo pipefail

BUILD_PREFIX="${JOB_NAME}/${BUILD_NUMBER}-${IMAGE_TAG}"

upload_if_present() {
  local prefix="$1"
  local report="$2"
  if [ -f "${report}" ]; then
    aws s3 cp "${report}" \
      "s3://${SECURITY_REPORT_BUCKET}/reports/${prefix}/${BUILD_PREFIX}/$(basename "${report}")" \
      --only-show-errors
  else
    echo "Skipping missing report: ${report}"
  fi
}

upload_if_present secrets scan-reports/gitleaks-report.json
upload_if_present sca scan-reports/trivy-sca-report.json
upload_if_present sca scan-reports/trivy-sca-report.html
upload_if_present sast scan-reports/sonar-issues.json
upload_if_present container scan-reports/container-scan-report.json
upload_if_present dast scan-reports/zap-report.json
upload_if_present dast scan-reports/zap-report.html
upload_if_present dast scan-reports/zap-report.xml
upload_if_present iac scan-reports/checkov_report.json
upload_if_present metadata scan-reports/security-integration-status.txt
upload_if_present normalized scan-reports/normalized/findings.json
upload_if_present normalized scan-reports/normalized/summary.json

if [ -f scan-reports/asff/securityhub-asff.json ]; then
  aws s3 cp scan-reports/asff/securityhub-asff.json \
    "s3://${SECURITY_REPORT_BUCKET}/reports/asff/${BUILD_PREFIX}/securityhub-asff.json" \
    --only-show-errors
fi
'''
                }
              }
            }
          }
        }

        stage('18. Production Approval') {
          when {
            allOf {
              expression { params.PROMOTE_PRODUCTION }
              expression { env.IS_RELEASE_BRANCH == 'true' }
            }
          }
          steps {
            script {
              Map approval = [
                id: 'ProductionPromotion',
                message: "Promote immutable image ${env.IMAGE_URI} to production?",
                ok: 'Promote to production'
              ]
              if (params.PRODUCTION_APPROVERS.trim()) {
                approval.submitter = params.PRODUCTION_APPROVERS.trim()
                approval.submitterParameter = 'APPROVED_BY'
              }

              timeout(time: env.APPROVAL_TIMEOUT.toInteger(), unit: 'MINUTES') {
                Object result = input(approval)
                env.APPROVED_BY = result ? result.toString() : 'authenticated-user'
              }
              echo "Production promotion approved by ${env.APPROVED_BY}."
            }
          }
        }

        stage('19. Update GitOps Production') {
          when {
            allOf {
              expression { params.PROMOTE_PRODUCTION }
              expression { params.ENABLE_GITOPS_UPDATE }
              expression { env.IS_RELEASE_BRANCH == 'true' }
            }
          }
          steps {
            script {
              updateGitOpsOverlay('production')
            }
          }
        }

        stage('20. Deploy ECS Production') {
          when {
            allOf {
              expression { params.PROMOTE_PRODUCTION }
              expression { params.ENABLE_ECS_DEPLOY }
              expression { env.IS_RELEASE_BRANCH == 'true' }
            }
          }
          steps {
            script {
              withAwsAuth {
                deployEcsService(
                  params.ECS_PRODUCTION_SERVICE,
                  params.ECS_PRODUCTION_TASK_FAMILY,
                  params.ECS_PRODUCTION_DESIRED_COUNT
                )
              }
            }
          }
        }

        stage('21. Summary') {
          steps {
            echo """CI/CD pipeline completed.
Source: ${env.SOURCE_BRANCH}@${env.GIT_COMMIT_SHORT}
Image: ${env.IMAGE_URI}
Demo preset: ${env.DEMO_PRESET_EFFECTIVE}
Security mode: ${params.SECURITY_MODE}
DAST gate mode: ${env.DAST_GATE_MODE_EFFECTIVE}
GitOps enabled: ${params.ENABLE_GITOPS_UPDATE}
ECS enabled: ${params.ENABLE_ECS_DEPLOY}
Security Hub import enabled: ${params.ENABLE_SECURITY_HUB_IMPORT}
Production requested: ${params.PROMOTE_PRODUCTION}
"""
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts(
        artifacts: 'scan-reports/**/*',
        allowEmptyArchive: true,
        fingerprint: true
      )
    }
    cleanup {
      script {
        if (params.REGISTRY_TARGET == 'ecr' && env.REGISTRY) {
          sh(script: 'docker logout "${REGISTRY}" >/dev/null 2>&1 || true')
        }
      }
    }
  }
}
