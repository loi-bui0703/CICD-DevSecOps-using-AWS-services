{
  "containerDefinitions": [
    {
      "name": "volume-permissions",
      "image": "585572506644.dkr.ecr.ap-southeast-1.amazonaws.com/devsecops/tetris:latest",
      "cpu": 0,
      "portMappings": [],
      "essential": false,
      "command": [
        "sh",
        "-c",
        "chown -R 101:101 /var/cache/nginx /tmp"
      ],
      "environment": [],
      "mountPoints": [
        {
          "sourceVolume": "nginx-cache",
          "containerPath": "/var/cache/nginx",
          "readOnly": false
        },
        {
          "sourceVolume": "nginx-tmp",
          "containerPath": "/tmp",
          "readOnly": false
        }
      ],
      "volumesFrom": [],
      "user": "0",
      "readonlyRootFilesystem": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/devsecops-factory",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "volume-permissions"
        }
      },
      "systemControls": []
    },
    {
      "name": "tetris",
      "image": "585572506644.dkr.ecr.ap-southeast-1.amazonaws.com/devsecops/tetris:5d2005dd0265",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [],
      "mountPoints": [
        {
          "sourceVolume": "nginx-cache",
          "containerPath": "/var/cache/nginx",
          "readOnly": false
        },
        {
          "sourceVolume": "nginx-tmp",
          "containerPath": "/tmp",
          "readOnly": false
        }
      ],
      "volumesFrom": [],
      "dependsOn": [
        {
          "containerName": "volume-permissions",
          "condition": "SUCCESS"
        }
      ],
      "user": "101",
      "readonlyRootFilesystem": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/devsecops-factory",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "tetris"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -q -O /dev/null http://localhost:8080/ || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "systemControls": []
    }
  ],
  "family": "tetris-app",
  "taskRoleArn": "arn:aws:iam::585572506644:role/devsecops-factory-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::585572506644:role/devsecops-factory-ecs-execution-role",
  "networkMode": "awsvpc",
  "volumes": [
    {
      "name": "nginx-cache",
      "host": {}
    },
    {
      "name": "nginx-tmp",
      "host": {}
    }
  ],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
